cat > .gitignore <<'EOF'
# Environment / secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
EOF

# Context files
.context/
